# Comments are off unless this is true, or dev (only under `vite dev`).
VISUAL_COMMENTS_ENABLED=dev
# The comment server and this site's space on it: `pnpm -F @visual-comments/server dev`.
VISUAL_COMMENTS_SERVER=http://localhost:4400
VISUAL_COMMENTS_SPACE=demo
VISUAL_COMMENTS_SECRET=development-only-secret-for-the-demo-space
# Where this site answers comment requests and has its sign-in routes. These are the defaults.
# VISUAL_COMMENTS_PATH=/_comments
# VISUAL_COMMENTS_AUTH=/auth
