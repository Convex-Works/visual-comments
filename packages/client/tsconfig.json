{
	"compilerOptions": {
		"target": "es2024",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2024", "dom", "dom.iterable"],
		"strict": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["@sveltejs/kit"]
	},
	"include": ["src", "scripts", "vite.config.ts"]
}
