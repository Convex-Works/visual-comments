{
	"name": "visual-comments",
	"version": "0.1.0",
	"description": "Comments pinned to the elements of any web page or app, with one comment server for every site.",
	"keywords": [
		"comments",
		"annotations",
		"feedback",
		"design-review",
		"preview-comments",
		"svelte",
		"sveltekit",
		"self-hosted"
	],
	"homepage": "https://github.com/Convex-Works/visual-comments#readme",
	"bugs": {
		"url": "https://github.com/Convex-Works/visual-comments/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Convex-Works/visual-comments.git",
		"directory": "packages/client"
	},
	"license": "MIT",
	"author": "Convex Works",
	"type": "module",
	"scripts": {
		"css": "node scripts/build-css.mjs",
		"build": "pnpm css && svelte-package -i src/lib -o dist && vite build",
		"dev": "node scripts/build-css.mjs --watch & vite build --watch",
		"check": "pnpm css && svelte-check --tsconfig ./tsconfig.json",
		"prepack": "pnpm build"
	},
	"files": [
		"dist",
		"dist-widget",
		"!dist-widget/*.map"
	],
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js"
		},
		"./widget.js": "./dist-widget/visual-comments.js"
	},
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/cli": "^4.3.0",
		"@types/node": "^26.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.0"
	}
}
