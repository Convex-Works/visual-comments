{
	"name": "@visual-comments/server",
	"private": true,
	"type": "module",
	"description": "The visual-comments server: comment threads for every space, called by the sites' own servers.",
	"scripts": {
		"start": "node src/main.ts",
		"dev": "SPACES=spaces.dev.json DATABASE=data/dev.sqlite node --watch src/main.ts",
		"test": "node --test 'test/*.test.ts'",
		"check": "tsc --noEmit -p ."
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"typescript": "~6.0.3"
	}
}
